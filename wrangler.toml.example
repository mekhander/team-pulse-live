name = "team-pulse-live"
main = "worker/index.js"
compatibility_date = "2026-11-23"

[[d1_databases]]
binding = "DB"
database_name = "team-pulse-live"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

[vars]
ALLOWED_ORIGIN = "https://mekhander.github.io"

# Register these with `wrangler secret put`, never in this file:
# ADMIN_TOKEN
# DUPLICATE_SALT
